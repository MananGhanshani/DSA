class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
        vector <int> inte;
        for ( int i = 0; i < nums1.size(); i++){
            for ( int j = 0; j < nums2.size(); j++){
                if (find(inte.begin(), inte.end(), nums1[i]) == inte.end()){
                    if( nums1[i] == nums2[j]){

                        inte.push_back(nums1[i]);
                        break;
                    }
                }
            }
        }
    return inte;
    }
};
