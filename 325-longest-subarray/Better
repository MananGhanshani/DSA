class Solution {
public:
    int longestSubarray(vector<int>& nums, int k) {
        map<int,int> presumap;

        int sum = 0;
        int maxlen = 0;
        int n = nums.size();

        for ( int i = 0; i < n ; i++){
            sum += nums[i];
            if(sum == k){
                maxlen = max(maxlen, i+1);
            }
            int rem = sum - k;

            if (presemap.find(rem) != presumap.end()){
                int len = i - presumap[rem];
                maxlen = max(maxlen, len);
            }
            if (presumap.find(sum) == presumap.end()) {
                presumap[sum] = i;
            }
        }
        return maxlen;
    }
};
